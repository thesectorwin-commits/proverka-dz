# --- Anthropic (Claude) ---
# Живёт ТОЛЬКО на сервере. Никогда не добавляйте префикс NEXT_PUBLIC_.
ANTHROPIC_API_KEY=sk-ant-...

# --- OpenAI (gpt-5.4-mini) ---
# Используется в двух местах: scripts/test-gpt56-luna.ts (одноразовые
# сравнительные тесты) и lib/openai.ts — второй, переключаемый провайдер
# проверки (см. lib/aiProvider.ts). По умолчанию проверка идёт через
# Claude, а этот ключ вообще не вызывается — но раз переключатель в
# админке может быть включён в любой момент, ключ нужен в проде заранее,
# не только для локальных тестов.
OPENAI_API_KEY=sk-...

# --- Supabase ---
# URL и service_role ключ берутся в Supabase → Project Settings → API.
# service_role даёт полный доступ в обход RLS — храните только в серверных
# переменных окружения (Vercel: Environment Variables, не в коде).
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Яндекс ID (OAuth) ---
# Регистрация приложения: https://oauth.yandex.ru/
YANDEX_CLIENT_ID=...
YANDEX_CLIENT_SECRET=...
# Должен точно совпадать с Redirect URI, указанным в настройках приложения Яндекса
YANDEX_REDIRECT_URI=http://localhost:3000/api/auth/yandex/callback

# --- Сессии ---
# Сгенерировать: openssl rand -base64 32
SESSION_SECRET=

# --- Админка (логин/пароль, отдельно от Яндекс ID) ---
ADMIN_USERNAME=
# Хеш пароля (соль:hash), генерируется через lib/adminAuth.ts → hashPassword().
# НЕ сам пароль в открытом виде.
ADMIN_PASSWORD_HASH=

# --- Web Push (PWA-уведомления) ---
# Сгенерировать пару: npx web-push generate-vapid-keys
# Публичный ключ уходит в браузер, поэтому с префиксом NEXT_PUBLIC_.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
